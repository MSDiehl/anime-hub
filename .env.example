# Docker database
POSTGRES_USER=animehub
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=animehub
POSTGRES_PORT=5432

# Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7162;http://localhost:5162
ConnectionStrings__Default=Host=localhost;Port=5432;Database=animehub;Username=animehub;Password=change-this-db-password
ConnectionStrings__Redis=localhost:6379
ExternalApis__AniList__BaseUrl=https://graphql.anilist.co
Cors__AllowedOrigins__0=http://localhost:5173
Identity__RequireConfirmedEmail=true
SeedData__Enabled=false
SeedData__DemoEmail=demo@animehub.local
SeedData__DemoPassword=change-this-local-demo-password

# Optional account email delivery. If SMTP is absent in Development, tokens are logged.
AccountEmail__ApiBaseUrl=https://localhost:7162
AccountEmail__PublicBaseUrl=http://localhost:5173
AccountEmail__FromEmail=
AccountEmail__Smtp__Host=
AccountEmail__Smtp__Port=587
AccountEmail__Smtp__EnableSsl=true
AccountEmail__Smtp__UserName=
AccountEmail__Smtp__Password=

# Frontend
VITE_DEV_PORT=5173
VITE_API_TARGET=https://127.0.0.1:7162
