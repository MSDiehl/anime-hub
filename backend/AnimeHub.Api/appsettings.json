{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExternalApis": {
    "AniList": {
      "BaseUrl": "https://graphql.anilist.co"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Identity": {
    "RequireConfirmedEmail": true,
    "Password": {
      "RequiredLength": 12,
      "RequiredUniqueChars": 6
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "Minutes": 15
    }
  },
  "Swagger": {
    "Enabled": false,
    "RequireAuthentication": true
  },
  "AccountEmail": {
    "ApiBaseUrl": "",
    "PublicBaseUrl": "",
    "FromEmail": "",
    "FromName": "AnimeHub",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": ""
    }
  },
  "AllowedHosts": "*"
}
