{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExternalApis": {
    "AniList": {
      "BaseUrl": "https://graphql.anilist.co"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Identity": {
    "RequireConfirmedEmail": true,
    "Password": {
      "RequiredLength": 8,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 8,
      "Minutes": 5
    }
  },
  "Swagger": {
    "Enabled": true
  },
  "AccountEmail": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "SeedData": {
    "Enabled": false,
    "DemoEmail": "demo@animehub.local"
  }
}
